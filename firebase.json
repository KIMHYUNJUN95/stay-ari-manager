{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".env",
        ".env.*",
        "serviceAccountKey.json",
        "check-*.js",
        "check_*.js",
        "count-*.js",
        "debug_*.js",
        "manual-*.js",
        "test-*.js",
        "test_*.js"
      ]
    }
  ],
  "hosting": {
    "site": "my-booking-app-3f0e7",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
